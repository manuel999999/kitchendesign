{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "2a7a5170e35742a0b114e01231993485",
    "m_Title": "Calculate the vertex's local upward Offset in world-space",
    "m_Content": "Otherwise, if we were to use object-space, the offset would be unintentionally magnified by the object's scale.\n\nThis upward offset is important to fix z-fighting when the camera is looking at a surface that is nearly parallel to the camera's view angle (e.g., countertops). In those cases, shifting the vertices closer to the camera may not be enough to solve z-fighting.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -3821.0,
        "y": -767.0,
        "width": 638.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

