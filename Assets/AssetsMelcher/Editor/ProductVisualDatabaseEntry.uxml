<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="HorizontalLayout" style="flex-direction: row; height: 30px; justify-content: flex-start; align-items: center;">
        <ui:VisualElement name="Status" style="flex-grow: 0; flex-direction: row; background-image: none; background-color: rgba(0, 0, 0, 0); width: 30px; height: 100%; min-width: 30px; max-width: 30px; max-height: 100%; min-height: 100%;" />
        <uie:ObjectField name="Visual" allow-scene-objects="false" type="UnityEngine.GameObject, UnityEngine" style="flex-shrink: 1; flex-grow: 0; width: 100px; min-width: auto;" />
        <ui:TextField picking-mode="Ignore" name="VisualName" is-delayed="true" style="flex-grow: 1; margin-right: 1px; flex-shrink: 1; max-width: 100px;" />
        <ui:TextField picking-mode="Ignore" name="Id" is-delayed="true" style="flex-grow: 1; margin-right: 1px; flex-shrink: 1; width: 140px; min-width: auto;" />
        <uie:ObjectField name="Prefab" allow-scene-objects="false" type="UnityEngine.Object, UnityEngine.CoreModule" class="unity-disabled" style="flex-shrink: 1; flex-grow: 0; width: 100px;" />
        <uie:ObjectField name="Lightweight" allow-scene-objects="false" type="UnityEngine.Object, UnityEngine.CoreModule" class="unity-disabled" style="flex-shrink: 1; flex-grow: 0; width: 100px;" />
        <uie:ObjectField name="UnderlyingAsset" allow-scene-objects="false" type="UnityEngine.Object, UnityEngine.CoreModule" class="unity-disabled" style="flex-shrink: 1; flex-grow: 0; width: 200px;" />
        <uie:EnumField type="KitchenDesign.Shared.Enums.ProductAnchor, KitchenDesign.Shared" name="Anchor" style="flex-shrink: 1; width: 160px; min-width: auto; max-width: none; display: none;" />
        <ui:VisualElement name="Thumbnail" style="flex-grow: 0; flex-direction: row; width: 30px; height: 100%; background-color: rgba(0, 0, 0, 0); max-width: 30px; min-width: 30px; max-height: 100%; min-height: 100%;" />
        <ui:Button text="Render Thumbnail" display-tooltip-when-elided="true" name="RenderThumbnail" style="min-width: 100px;" />
        <ui:Button text="✔" display-tooltip-when-elided="true" name="ApproveModel" tooltip="Save the hash of the visual&apos;s assets into the Product Visual. When this is red, the underlying data (model, texture, etc.) hash has changed since it was last approved." style="min-width: 30px;" />
    </ui:VisualElement>
</ui:UXML>
